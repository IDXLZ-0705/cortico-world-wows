{
  "name": "@idxlz-0705/cortico-world-wows",
  "version": "0.3.0-beta",
  "type": "module",
  "description": "截屏看《战舰世界》，让桌宠实时解说战况：击沉夸奖、高光喝彩、逆风打气。解说基调四档可选，费用可控。支持任意 OpenAI 兼容视觉端点（如千问 qwen3-vl-plus、智谱 glm-4v 等）。",
  "license": "MIT",
  "author": "IDXLZ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idxlz-0705/cortico-world-wows.git"
  },
  "homepage": "https://github.com/idxlz-0705/cortico-world-wows#readme",
  "keywords": [
    "cortico-world",
    "cortico"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "战舰世界桌宠",
    "tags": [],
    "describe": "describe.json"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "describe.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jimp": "^1.6.0",
    "screenshot-desktop": "^1.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
